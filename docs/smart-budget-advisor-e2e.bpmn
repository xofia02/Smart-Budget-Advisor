<bpmn:process id="Process_SBA" name="Planejar e controlar o orçamento de uma viagem" isExecutable="false">
<bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_V" name="Viajante"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_login</bpmn:flowNodeRef><bpmn:flowNodeRef>t_criar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_ajustar</bpmn:flowNodeRef><bpmn:flowNodeRef>ev_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>t_despesa</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_duvida</bpmn:flowNodeRef><bpmn:flowNodeRef>t_pergunta</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_m2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_fim</bpmn:flowNodeRef><bpmn:flowNodeRef>t_ver</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_S" name="Sistema"><bpmn:flowNodeRef>t_auth</bpmn:flowNodeRef><bpmn:flowNodeRef>t_validar</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>t_prev</bpmn:flowNodeRef><bpmn:flowNodeRef>t_dist</bpmn:flowNodeRef><bpmn:flowNodeRef>t_dicas</bpmn:flowNodeRef><bpmn:flowNodeRef>t_salvar</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_limite</bpmn:flowNodeRef><bpmn:flowNodeRef>t_alerta</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_m1</bpmn:flowNodeRef><bpmn:flowNodeRef>t_chat</bpmn:flowNodeRef><bpmn:flowNodeRef>t_relatorio</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="start" name="Viagem a planejar"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="t_login" name="Entrar ou criar conta"><bpmn:documentation>RF-001</bpmn:documentation><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t_auth" name="Autenticar usuário"><bpmn:documentation>RF-001, RNF-004</bpmn:documentation><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="t_criar" name="Criar viagem"><bpmn:documentation>RF-003</bpmn:documentation><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t_validar" name="Validar dados da viagem"><bpmn:documentation>RN-001, RN-003, RNF-006</bpmn:documentation><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="gw_valid" name="Dados válidos?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_prev" name="Gerar previsão de custos"><bpmn:documentation>RF-004, RN-002</bpmn:documentation><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_dist" name="Sugerir divisão do orçamento"><bpmn:documentation>RF-005, RN-004</bpmn:documentation><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="t_ajustar" name="Ajustar orçamento por categoria"><bpmn:documentation>RF-005, RN-005</bpmn:documentation><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t_dicas" name="Salvar e gerar dicas de economia"><bpmn:documentation>RF-009</bpmn:documentation><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask><bpmn:intermediateCatchEvent id="ev_inicio" name="Início da viagem"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:timerEventDefinition id="ted1"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">${dataInicio}</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:userTask id="t_despesa" name="Registrar despesa"><bpmn:documentation>RF-006</bpmn:documentation><bpmn:incoming>f12</bpmn:incoming><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t_salvar" name="Validar e salvar despesa"><bpmn:documentation>RF-006, RN-006, RN-008</bpmn:documentation><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="gw_limite" name="Passou de 80% da categoria?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_alerta" name="Exibir alerta de orçamento"><bpmn:documentation>RF-007</bpmn:documentation><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="gw_m1"><bpmn:incoming>f16</bpmn:incoming><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="gw_duvida" name="Tem dúvida?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="t_pergunta" name="Perguntar ao assistente"><bpmn:documentation>RF-008</bpmn:documentation><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="t_chat" name="Responder com IA"><bpmn:documentation>RF-008, RN-007</bpmn:documentation><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="gw_m2"><bpmn:incoming>f20</bpmn:incoming><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="gw_fim" name="A viagem terminou?"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing><bpmn:outgoing>f25</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_relatorio" name="Gerar relatório final"><bpmn:documentation>RF-010</bpmn:documentation><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="t_ver" name="Consultar relatório"><bpmn:documentation>RF-010</bpmn:documentation><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="end" name="Fim"><bpmn:incoming>f27</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_login"/><bpmn:sequenceFlow id="f2" sourceRef="t_login" targetRef="t_auth"/><bpmn:sequenceFlow id="f3" sourceRef="t_auth" targetRef="t_criar"/><bpmn:sequenceFlow id="f4" sourceRef="t_criar" targetRef="t_validar"/><bpmn:sequenceFlow id="f5" sourceRef="t_validar" targetRef="gw_valid"/><bpmn:sequenceFlow id="f6" name="Não" sourceRef="gw_valid" targetRef="t_criar"/><bpmn:sequenceFlow id="f7" name="Sim" sourceRef="gw_valid" targetRef="t_prev"/><bpmn:sequenceFlow id="f8" sourceRef="t_prev" targetRef="t_dist"/><bpmn:sequenceFlow id="f9" sourceRef="t_dist" targetRef="t_ajustar"/><bpmn:sequenceFlow id="f10" sourceRef="t_ajustar" targetRef="t_dicas"/><bpmn:sequenceFlow id="f11" sourceRef="t_dicas" targetRef="ev_inicio"/><bpmn:sequenceFlow id="f12" sourceRef="ev_inicio" targetRef="t_despesa"/><bpmn:sequenceFlow id="f13" sourceRef="t_despesa" targetRef="t_salvar"/><bpmn:sequenceFlow id="f14" sourceRef="t_salvar" targetRef="gw_limite"/><bpmn:sequenceFlow id="f15" name="Sim" sourceRef="gw_limite" targetRef="t_alerta"/><bpmn:sequenceFlow id="f16" name="Não" sourceRef="gw_limite" targetRef="gw_m1"/><bpmn:sequenceFlow id="f17" sourceRef="t_alerta" targetRef="gw_m1"/><bpmn:sequenceFlow id="f18" sourceRef="gw_m1" targetRef="gw_duvida"/><bpmn:sequenceFlow id="f19" name="Sim" sourceRef="gw_duvida" targetRef="t_pergunta"/><bpmn:sequenceFlow id