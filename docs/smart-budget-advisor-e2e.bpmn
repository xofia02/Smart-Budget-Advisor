<bpmn:messageFlow id="m1" name="dados da viagem" sourceRef="t_prev" targetRef="P_ia"/><bpmn:messageFlow id="m2" name="previsão" sourceRef="P_ia" targetRef="t_prev"/><bpmn:messageFlow id="m3" name="destino" sourceRef="t_dicas" targetRef="P_ia"/><bpmn:messageFlow id="m4" name="dicas" sourceRef="P_ia" targetRef="t_dicas"/><bpmn:messageFlow id="m5" name="pergunta" sourceRef="t_chat" targetRef="P_ia"/><bpmn:messageFlow id="m6" name="resposta" sourceRef="P_ia" targetRef="t_chat"/>
